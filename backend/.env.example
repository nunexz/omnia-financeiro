# Database
DATABASE_URL="mysql://user:password@localhost:3306/omnia_financeiro"

# JWT
JWT_SECRET="sua-chave-super-secreta-aqui"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="seu-google-client-id"
